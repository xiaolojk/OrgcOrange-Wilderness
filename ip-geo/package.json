{
  "name": "ip-geo-query",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "🌐 IP·GEO 归属地查询 | 双语中英 · 用户可选数据源 · 批量 · 收藏 · 深色模式 | Capacitor + Vite + TS",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "apk": "npm run build && npx cap sync android && cd android && gradle assembleDebug --no-daemon"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.19.0"
  }
}
