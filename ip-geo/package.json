{
  "name": "ip-geo-query",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "🌐 IP 归属地查询安卓 APP | IP/域名查询·批量查询·历史·收藏·深色模式 | Capacitor + Vite + TS",
  "scripts": {
    "dev": "vite",
